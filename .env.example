# Copy this file to .env.local for local development.
# In Vercel production, set these as Environment Variables in the dashboard.
# NEVER commit a real .env file with actual values.

# === REQUIRED ===

# Anthropic API key — get from https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Supabase project URL and anon key — from Supabase project Settings → API
SUPABASE_URL=https://yourproject.supabase.co
SUPABASE_ANON_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# === OPTIONAL — Cost protection ===

# A passphrase that the frontend sends as a header on AI calls.
# Random scrapers won't have it; they'll be blocked with 401.
# Make this anything — a random string of 20-30 characters works.
# (You can generate one at https://www.random.org/strings/)
APP_SECRET=change-me-to-something-random-like-your-cats-name-and-some-numbers

# Hard daily spend ceiling in USD. Once today's API spend exceeds this,
# all AI endpoints return 429 until midnight UTC. Default 2.00.
DAILY_SPEND_CEILING_USD=2.00
